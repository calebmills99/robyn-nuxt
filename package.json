{
  "name": "robyn-nuxt",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && node scripts/postbuild-ipx.mjs && node scripts/postbuild-headers.mjs",
    "preview": "wrangler dev",
    "lint:copy": "node scripts/copy-lint.mjs .output/public",
    "check:redirects": "node scripts/check-redirects.mjs",
    "deploy:preview": "npm run build && node scripts/copy-lint.mjs .output/public && wrangler deploy",
    "build:home": "node scripts/build-home.mjs",
    "deploy:home": "node scripts/test-home-routing.mjs && node scripts/build-home.mjs && node scripts/copy-lint.mjs .output/public && wrangler deploy -c wrangler.home.jsonc",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/content": "3.16.1",
    "@nuxt/image": "2.1.0",
    "@nuxtjs/robots": "6.2.3",
    "@nuxtjs/sitemap": "8.5.1",
    "hls.js": "1.7.3",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "nuxt": "4.5.2",
    "nuxt-link-checker": "5.3.0",
    "nuxt-site-config": "4.2.3",
    "nuxt-studio": "1.7.0",
    "remark-smartypants": "^3.0.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "better-sqlite3": "13.0.3",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "wrangler": "4.141.0",
    "yaml": "2.9.1"
  }
}
