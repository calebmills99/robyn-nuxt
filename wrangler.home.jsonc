{
  "$schema": "node_modules/wrangler/config-schema.json",
  // PRODUCTION Worker for the 4 block pages on golden-wings-robyn.com and www.
  // Build + deploy: npm run deploy:home (SITE_ENV=production build: indexable, no X-Robots-Tag).
  // Routes golden-wings-robyn.com/* and www.golden-wings-robyn.com/* are added once, at cutover,
  // in front of the live Worker golden-wings-robyn (custom domains). Rollback = delete those 2 routes.
  "name": "golden-wings-robyn-home",
  "main": "home-worker.mjs",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Only hashed build files skip the Worker; every other path must reach home-worker.mjs so it can pass through.
    "run_worker_first": ["/*", "!/_nuxt/*"]
  },
  "vars": { "SITE_ENV": "production", "HOME_PASSTHROUGH": "1" },
  "observability": { "enabled": true }
}
