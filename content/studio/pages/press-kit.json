        {
          "_uid": "012d3be9-5542-428b-b5d1-a9901834d675",
          "name": "Gwingz Studios",
          "role": "Production company",
          "component": "credit-row"
        },
        {
          "_uid": "930ebf3d-d052-4e9e-8448-c124a3e83d28",
          "name": "Golden Wings: Stewardess to Sky Queen (short)",
          "role": "Based on",
          "component": "credit-row"
        }
      ],
      "theme": "light",
      "people": [
        {
          "_uid": "d7360aec-dfd0-49ba-b431-d6060e1836ba",
          "name": "Robyn Stewart",
          "text": "American Airlines flight attendant since 1971. Trained under Millie Alford; among the first flight attendants trained to fly the 747. Marked 55 years of service in July 2026.",
          "badge": "Legacy Producer",
          "component": "credit-person"
        },
        {
          "_uid": "37db3077-09c6-46c7-8d0d-3c012f49c589",
          "name": "Jock Bethune",
          "text": "Longtime \"voice of American Airlines.\" Worked alongside Jay R. Ricks on the 747 training program; his interview at the C.R. Smith Museum anchors the feature.",
          "badge": "",
          "component": "credit-person"
        },
        {
          "_uid": "59b2cbba-1176-4c85-b364-14b94d9b2c67",
          "name": "Jay R. Ricks",
          "text": "WWII navigator, American Airlines flight engineer. Helped build the airline's 747 training program. Robyn Stewart's father.",
          "badge": "",
          "component": "credit-person"
        },
        {
          "_uid": "a55c68a9-55cd-4621-b6f0-a9c00fd78fbf",
          "name": "Caleb Mills Stewart",
          "text": "Director. Began Golden Wings as a student project at Academy of Art University, shot on a smartphone. Robyn Stewart's son.",
          "badge": "",
          "component": "credit-person"
        }
      ],
      "eyebrow": "Credits",
      "heading": "Key subjects & crew",
